{
  "manifest_version": 3,
  "name": "F&O API Studio — D365 API Tester",
  "short_name": "F&O API Studio",
  "version": "0.1.0",
  "description": "Postman-style tester for Dynamics 365 Finance & Operations: OData, JSON and SOAP custom services with saved environments.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://example.com/fo-api-studio",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Open F&O API Studio",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "permissions": ["sidePanel", "storage", "identity"],
  "host_permissions": [
    "https://*.dynamics.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
